# PostgreSQL connection string (pool-compatible)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/image_api_db"

# PostgreSQL direct connection string (unpooled, for migrations)
DIRECT_DATABASE_URL="postgres://postgres:postgres@localhost:5432/image_api_db"

# Better Auth Secret (generate with `openssl rand -base64 32`)
BETTER_AUTH_SECRET="development-insecure-placeholder-secret-replace-in-production-min-32-chars"

# Better Auth Base URL
BETTER_AUTH_URL="http://localhost:3000"

# Application Base URL (Public)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Environment (development | staging | production)
DATABASE_ENV="development"

# Pinned Development Endpoint ID (for Neon hostname validation, e.g. ep-example-development)
DEVELOPMENT_DATABASE_ENDPOINT_ID="ep-example-development"

# Integration Test Safety Guard (must be explicitly 'true' to execute live database integration tests)
RUN_DB_INTEGRATION_TESTS="false"

# Local Loopback Base URL for HTTP E2E Verification (must only target localhost/127.0.0.1)
HTTP_E2E_BASE_URL="http://127.0.0.1:3000"
