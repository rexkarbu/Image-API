{
  "name": "image-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "dotenv -e .env.local -e .env -- vitest run --config vitest.integration.config.ts",
    "test:redis-integration": "dotenv -e .env.local -e .env -- vitest run tests/integration/redis-ratelimit.test.ts --config vitest.integration.config.ts",
    "test:stripe-integration": "dotenv -e .env.local -e .env -- vitest run tests/integration/stripe-billing.test.ts --config vitest.integration.config.ts",
    "test:webhook-e2e": "dotenv -e .env.local -e .env -- vitest run tests/integration/stripe-webhook-e2e.test.ts --config vitest.integration.config.ts",
    "db:generate": "dotenv -e .env.local -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -e .env -- tsx src/db/migrate.ts",
    "db:check": "dotenv -e .env.local -e .env -- drizzle-kit check",
    "db:smoke": "dotenv -e .env.local -e .env -- tsx src/db/smoke.ts",
    "db:verify": "dotenv -e .env.local -e .env -- tsx src/db/verify-metadata.ts",
    "db:studio": "dotenv -e .env.local -e .env -- drizzle-kit studio",
    "verify:http": "dotenv -e .env.local -e .env -- tsx src/db/http-e2e-verification.ts",
    "stripe:verify-config": "dotenv -e .env.local -e .env -- tsx src/scripts/stripe-verify-config.ts",
    "billing:worker": "dotenv -e .env.local -e .env -- tsx src/scripts/billing-worker-cli.ts",
    "billing:reconcile": "dotenv -e .env.local -e .env -- tsx src/scripts/billing-reconcile-cli.ts",
    "openapi:check": "tsx src/scripts/openapi-check.ts",
    "deploy:preflight": "dotenv -e .env.local -e .env -- tsx src/scripts/deploy-preflight.ts",
    "deploy:verify": "tsx src/scripts/deploy-verify.ts",
    "health:check": "tsx src/scripts/health-check-cli.ts"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/otel": "2.1.3",
    "better-auth": "^1.1.21",
    "busboy": "1.6.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.475.0",
    "next": "16.3.2",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "stripe": "22.5.0",
    "swagger-ui-dist": "5.32.14",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@eslint/eslintrc": "^3.2.0",
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@types/busboy": "1.5.4",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/swagger-ui-dist": "3.30.6",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "16.3.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
