{
  "name": "image-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "dotenv -e .env.local -e .env -- vitest run --config vitest.integration.config.ts",
    "db:generate": "dotenv -e .env.local -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -e .env -- tsx src/db/migrate.ts",
    "db:check": "dotenv -e .env.local -e .env -- drizzle-kit check",
    "db:smoke": "dotenv -e .env.local -e .env -- tsx src/db/smoke.ts",
    "db:studio": "dotenv -e .env.local -e .env -- drizzle-kit studio"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "better-auth": "^1.1.21",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.475.0",
    "next": "16.3.2",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "16.3.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
